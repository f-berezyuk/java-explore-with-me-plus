server.port=8080
management.server.port=8080

spring.jpa.hibernate.ddl-auto=none
spring.jpa.properties.hibernate.format_sql=true
spring.sql.init.mode=always


spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.url=jdbc:postgresql://ewm-db:5432/ewm-db
spring.datasource.username=ewmuser
spring.datasource.password=ewmpass
# suppress inspection "SpringPropertiesInspection"
stat-server.url=${STATS_SERVER_URL}